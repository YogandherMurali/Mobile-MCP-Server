        #region Validation Methods

        {{#INCLUDE_VALIDATION}}
        private bool ValidateInputs()
        {
            {{#INCLUDE_EMAIL_PASSWORD}}
            var email = EmailEntry.Text?.Trim();
            var password = PasswordEntry.Text;

            if (string.IsNullOrEmpty(email))
            {
                ShowValidationError("Please enter your email");
                return false;
            }

            if (!IsValidEmail(email))
            {
                ShowValidationError("Please enter a valid email address");
                return false;
            }

            if (string.IsNullOrEmpty(password))
            {
                ShowValidationError("Please enter your password");
                return false;
            }

            if (password.Length < 6)
            {
                ShowValidationError("Password must be at least 6 characters");
                return false;
            }
            {{/INCLUDE_EMAIL_PASSWORD}}

            return true;
        }

        private bool IsValidEmail(string email)
        {
            if (string.IsNullOrEmpty(email))
                return false;

            try
            {
                var addr = new System.Net.Mail.MailAddress(email);
                return addr.Address == email;
            }
            catch
            {
                return false;
            }
        }

        private void ShowValidationError(string message)
        {
            MessageLabel.Text = message;
            MessagesStack.IsVisible = true;
        }

        private void HideValidationError()
        {
            MessagesStack.IsVisible = false;
        }
